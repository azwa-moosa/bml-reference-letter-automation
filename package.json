{
  "name": "bml-reference-letters",
  "version": "0.2.0",
  "private": true,
  "description": "Reference Letter Automation: staff letter requests, line-manager and Total Rewards steps, ER Lead drafting, approval, reference numbers and letter PDFs. Built from Rayya's prototype and handover spec.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "setup": "node scripts/ensure-env.mjs && npm run db:generate && npm run db:reset",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "postinstall": "node scripts/prisma-generate.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/tinos": "5.3.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-sqlite3": "12.11.1",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
