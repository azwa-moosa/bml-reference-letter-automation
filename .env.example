# Reference Letter Automation · copy to .env (never commit .env)

# Local SQLite database
DATABASE_URL="file:./prisma/dev.db"

# 32+ random characters; signs the demo sign-in cookie. Required everywhere except
# `npm run dev` and the tests (also when ALLOW_DEMO_SIGNIN=1).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=""

# The prototype fixed "today" to 27 Oct 2026 so the sample data makes sense.
# Leave empty for live use.
APP_TODAY="2026-10-27"
APP_TIMEZONE="Indian/Maldives"

# Year in RL-YYYY-#### and BML/HR-####/YYYY. Defaults to the year of "today".
REF_YEAR=""

# Only for a sandbox with sample data: allow the "Viewing as" switcher in production.
ALLOW_DEMO_SIGNIN=""

# Set to 1 only when running a production build over plain http on localhost
# (start-mac.command does this). Leave empty when served over HTTPS.
LOCAL_HTTP=""
